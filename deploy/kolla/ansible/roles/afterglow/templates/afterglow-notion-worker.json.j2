{
    "name": "afterglow_notion_worker",
    "image": "{{ afterglow_worker_image_ref }}",
    "command": ["python", "-m", "app.notion_worker"],
    "restart_policy": "unless-stopped",
    "volumes": [
        "/etc/kolla/config/afterglow/generated/afterglow.generated.conf:/app/afterglow.conf:ro",
        "kolla_logs:/var/log/kolla/"
    ],
    "environment": {
        "DATABASE_URL": "mysql+asyncmy://{{ afterglow_database_user }}:{{ afterglow_database_password }}@{{ database_address | default('mariadb') }}:{{ database_port | default(3306) }}/{{ afterglow_database_name }}",
        "REDIS_URL": "redis://:{{ afterglow_redis_password | default('') }}@{{ valkey_address | default('valkey') }}:{{ valkey_port | default(6379) }}/{{ afterglow_redis_db_index }}",
        "OS_PASSWORD": "{{ afterglow_admin_keystone_password }}",
        "OS_INTERFACE": "public",
        "SECRET_KEY": "{{ afterglow_secret_key }}",
        "K3S_KUBECONFIG_ENCRYPTION_KEY": "{{ afterglow_kubeconfig_encryption_key }}"
    }
}
