{
    "name": "afterglow_frontend",
    "image": "{{ afterglow_frontend_image_ref }}",
    "restart_policy": "unless-stopped",
    "volumes": [
        "kolla_logs:/var/log/kolla/",
        "/etc/kolla/config/afterglow/generated/afterglow.frontend.generated.conf:/app/afterglow.conf:ro"
    ],
    "environment": {
        "ORIGIN": "{{ afterglow_public_endpoint_url }}",
        "PUBLIC_API_BASE": "{{ afterglow_public_api_base }}"
    },
    "healthcheck": {
        "test": ["CMD", "curl", "-f", "http://localhost:3000/"],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "start_period": "30s"
    },
    "ports": ["{{ afterglow_frontend_port }}:3000"]
}
