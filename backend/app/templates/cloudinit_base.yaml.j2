#cloud-config
# Afterglow VM managed bootstrap
{% if has_layers %}# Legacy layer strategy: {{ strategy }}   libraries: {{ libraries | join(", ") }}{% endif %}

{% if github_ssh_import_id %}
ssh_import_id:
  - {{ github_ssh_import_id | tojson }}

{% endif %}
package_update: false
package_upgrade: false

{% if has_cephfs or has_nfs or (has_layers and strategy == "dynamic") %}
packages:
{% if has_cephfs %}
  - ceph-common
{% endif %}
{% if has_nfs %}
  - nfs-common
{% endif %}
{% if has_layers and strategy == "dynamic" %}
  - python3-pip
{% endif %}
{% else %}
packages: []
{% endif %}
{% if has_layers or gpu_available or data_mounts %}
write_files:
{% if has_cephfs %}
  # CephX 키링 파일 (CephFS 공유별)
{% for share in file_storages %}
{% if share.share_proto == "CEPHFS" %}
  - path: /etc/ceph/ceph.client.{{ share.cephx_id | shlex_quote }}.keyring
    permissions: "0600"
    content: |
      [client.{{ share.cephx_id | shlex_quote }}]
          key = {{ share.cephx_key | trim }}
{% endif %}
{% endfor %}

  # /etc/ceph/ceph.conf (모니터 주소)
  - path: /etc/ceph/ceph.conf
    content: |
      [global]
      mon host = {{ ceph_monitors }}
{% endif %}

{% if has_layers %}
  # OverlayFS 설정 스크립트
  - path: /opt/union/overlay_setup.sh
    permissions: "0750"
    content: |
{{ overlay_script | indent(6, first=True) }}

{% if strategy == "dynamic" %}
  # 동적 설치 스크립트 (Strategy B)
  - path: /opt/union/dynamic_install.sh
    permissions: "0750"
    content: |
{{ dynamic_script | indent(6, first=True) }}
{% endif %}

  # 환경변수 스크립트 (profile.d)
  - path: /etc/profile.d/union-env.sh
    permissions: "0644"
    content: |
      export PATH="/opt/layers/merged/usr/local/bin:/opt/layers/merged/bin:$PATH"
      export LD_LIBRARY_PATH="/opt/layers/merged/usr/local/lib:/opt/layers/merged/usr/local/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      export PYTHONPATH="{{ pythonpath }}${PYTHONPATH:+:$PYTHONPATH}"
      export PKG_CONFIG_PATH="/opt/layers/merged/usr/local/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
{% if gpu_available %}
      export CUDA_HOME="/usr/local/cuda"
      export LD_LIBRARY_PATH="/opt/layers/merged/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{% endif %}

  # systemd 유닛: 매 부팅 시 OverlayFS 재구성
  - path: /etc/systemd/system/union-overlay.service
    content: |
      [Unit]
      Description=Union OverlayFS Mount
      After=network-online.target remote-fs.target
      Requires=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/union/overlay_setup.sh
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target

{% endif %}
{% if has_layers and union_ro_share_export %}
  # envmgr 설정 (layer-store-ro export 경로 포함)
  - path: /etc/envmgr-union.conf
    permissions: "0600"
    content: |
      LAYER_STORE_RO_EXPORT="{{ union_ro_share_export }}"
{% if union_manifest_share_export %}
      MANIFEST_STORE_EXPORT="{{ union_manifest_share_export }}"
{% endif %}
{% endif %}

{% if gpu_available %}
  # GPU 스택(드라이버 + packaged DCGM daemon/exporter) 설치 스크립트
  - path: /opt/afterglow/install_gpu_monitoring.sh
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive

      ARCH_DEB="$(dpkg --print-architecture)"
      case "$ARCH_DEB" in
        amd64) CUDA_REPO_ARCH=x86_64 ;;
        arm64) CUDA_REPO_ARCH=sbsa ;;
        *) echo "unsupported NVIDIA repository architecture: $ARCH_DEB" >&2; exit 1 ;;
      esac

      # NVIDIA 드라이버 (없을 때만)
      if ! command -v nvidia-smi >/dev/null 2>&1; then
        echo "[gpu-install] NVIDIA 드라이버 미발견 — ubuntu-drivers autoinstall"
        apt-get update
        apt-get install -y ubuntu-drivers-common
        ubuntu-drivers autoinstall
      fi

      # NVIDIA CUDA repository + supported DCGM packages
      . /etc/os-release
      DISTRO="ubuntu${VERSION_ID//./}"
      KEYRING_PKG="cuda-keyring_1.1-1_all.deb"
      if [ ! -f /usr/share/keyrings/cuda-archive-keyring.gpg ]; then
        curl -fsSL \
          "https://developer.download.nvidia.com/compute/cuda/repos/${DISTRO}/${CUDA_REPO_ARCH}/${KEYRING_PKG}" \
          -o "/tmp/${KEYRING_PKG}"
        dpkg -i "/tmp/${KEYRING_PKG}"
        rm -f "/tmp/${KEYRING_PKG}"
      fi
      apt-get update
      apt-get install -y \
        datacenter-gpu-manager \
        datacenter-gpu-manager-exporter
      systemctl enable --now nvidia-dcgm.service
      systemctl enable --now nvidia-dcgm-exporter.service
{% endif %}

{% if has_layers and union_cephx_rotate_hours > 0 %}
  # CephX 키 회전 스크립트 (ExecStart 대상 — write_files 주입 필수)
  - path: /usr/local/bin/envmgr-rotate-key.sh
    permissions: "0750"
    content: |
{{ rotate_key_script | indent(6, first=True) }}

  # CephX 키 회전 systemd service
  - path: /etc/systemd/system/union-rotate-key.service
    content: |
      [Unit]
      Description=Union CephX Key Rotation
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=-/etc/envmgr.conf
      ExecStart=/usr/local/bin/envmgr-rotate-key.sh

  # CephX 키 회전 timer
  - path: /etc/systemd/system/union-rotate-key.timer
    content: |
      [Unit]
      Description=Union CephX Key Rotation Timer

      [Timer]
      OnBootSec=30min
      OnUnitActiveSec={{ union_cephx_rotate_hours }}h
      RandomizedDelaySec=5min
      Unit=union-rotate-key.service

      [Install]
      WantedBy=timers.target
{% endif %}

{% if health_check_script %}
  # 헬스체크 스크립트
  - path: /opt/union/scripts/health-check.sh
    permissions: "0750"
    content: |
{{ health_check_script | indent(6, first=True) }}

  # 헬스체크 systemd service
  - path: /etc/systemd/system/union-health.service
    content: |
      [Unit]
      Description=Union Instance Health Check
      Wants=union-overlay.service
      After=union-overlay.service

      [Service]
      Type=oneshot
      ExecStart=/opt/union/scripts/health-check.sh
      StandardOutput=journal
      StandardError=journal

  # 헬스체크 systemd timer (5분 주기)
  - path: /etc/systemd/system/union-health.timer
    content: |
      [Unit]
      Description=Union Instance Health Check Timer

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=5min
      Unit=union-health.service

      [Install]
      WantedBy=timers.target
{% endif %}

{% if data_mounts %}
{% for dm in data_mounts %}
{% if dm.share_proto == "CEPHFS" %}
  - path: /etc/ceph/ceph.client.{{ dm.cephx_id }}.keyring
    permissions: "0600"
    content: |
      [client.{{ dm.cephx_id }}]
          key = {{ dm.cephx_key | trim }}
{% endif %}
{% endfor %}

  - path: /opt/union/data_mounts.sh
    permissions: "0750"
    content: |
{{ data_mounts_script | indent(6, first=True) }}

  - path: /etc/systemd/system/afterglow-data-mounts.service
    content: |
      [Unit]
      Description=Afterglow Data Mounts
      After=network-online.target
      Requires=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/union/data_mounts.sh
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target
{% endif %}
{% else %}
write_files: []
{% endif %}

{% if has_layers or gpu_available or data_mounts %}
runcmd:
  - systemctl daemon-reload
{% if has_layers %}
  - mkdir -p /opt/layers/lower /opt/layers/upper /opt/layers/work /opt/layers/merged /opt/union/scripts /var/lib/union
  - systemctl enable union-overlay
  - systemctl start union-overlay
{% if health_check_script %}
  - systemctl enable --now union-health.timer
{% endif %}
{% if strategy == "dynamic" %}
  - /opt/union/dynamic_install.sh
{% endif %}
{% endif %}
{% if gpu_available %}
  - /opt/afterglow/install_gpu_monitoring.sh
{% endif %}
{% if data_mounts %}
  - systemctl enable --now afterglow-data-mounts.service
{% endif %}
{% else %}
runcmd: []
{% endif %}

final_message: |
  Afterglow VM 초기화 완료.
{% if has_layers %}
  전략: {{ strategy }}
  라이브러리: {{ libraries | join(", ") }}
  OverlayFS 상세: journalctl -u union-overlay --no-pager | tail -20
{% endif %}