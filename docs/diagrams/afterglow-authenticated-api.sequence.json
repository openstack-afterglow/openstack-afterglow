    {
      "id": "refresh-request",
      "from": "frontend",
      "to": "api",
      "y": 335,
      "label": "POST /api/v1/auth/refresh",
      "variant": "emphasis"
    },
    {
      "id": "refresh-session-check",
      "from": "api",
      "to": "redis",
      "y": 365,
      "label": "validate session · rotate refresh JTI",
      "variant": "security"
    },
    {
      "id": "refreshed-jwts",
      "from": "api",
      "to": "frontend",
      "y": 395,
      "label": "new access JWT (+ refresh JWT)",
      "variant": "return"
    },
    {
      "id": "resource-request",
      "from": "frontend",
      "to": "api",
      "y": 425,
      "label": "GET /api/v1/networks?cache=true · Authorization · X-Project-Id?",
      "variant": "emphasis"
    },
    {
      "id": "scope-and-catalog",
      "from": "api",
      "to": "keystone",
      "y": 450,
      "label": "verify JWT · authorize rescope · resolve catalog",
      "variant": "security"
    },
    {
      "id": "resource-call",
      "from": "api",
      "to": "openstack",
      "y": 480,
      "label": "caller-scoped openstacksdk request",
      "variant": "emphasis"
    },
    {
      "id": "json-response",
      "from": "api",
      "to": "frontend",
      "y": 505,
      "label": "200 JSON",
      "variant": "return"
