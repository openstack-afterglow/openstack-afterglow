    {
      "id": "persist-server-session",
      "from": "api",
      "to": "redis",
      "y": 275,
      "label": "bind Keystone session + refresh JTI",
      "variant": "security"
    },
    {
      "id": "jwt-pair",
      "from": "api",
      "to": "frontend",
      "y": 300,
