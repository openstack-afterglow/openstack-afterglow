  "segments": [
    {
      "from": 145,
      "to": 310,
      "label": "1 · Login and server session"
    },
    {
      "from": 320,
      "to": 405,
      "label": "2 · Refresh before an expiring request"
    },
    {
      "from": 415,
      "to": 510,
      "label": "3 · Authorized resource request"
    }
  ],
  "messages": [
    {
      "id": "submit-login",
      "from": "user",
      "to": "frontend",
      "y": 160,
      "label": "submit domain · username · password",
      "variant": "default"
    },
    {
      "id": "login-request",
      "from": "frontend",
      "to": "api",
      "y": 185,
      "label": "POST /api/v1/auth/login",
      "variant": "emphasis"
    },
    {
      "id": "keystone-auth",
      "from": "api",
      "to": "keystone",
      "y": 215,
      "label": "validate Keystone credentials",
      "variant": "security"
    },
    {
      "id": "keystone-catalog",
      "from": "keystone",
      "to": "api",
      "y": 245,
      "label": "token · catalog · roles",
      "variant": "return"
