# OpenStack 인증
OS_AUTH_URL=http://keystone.example.com:5000/v3
OS_PROJECT_NAME=admin
OS_PROJECT_DOMAIN_NAME=Default
OS_USER_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne

# Manila 설정
OS_MANILA_SHARE_NETWORK_ID=
OS_MANILA_SHARE_TYPE=cephfstype
# Union Mount 전용 service 프로젝트 UUID (Manila share + Builder VM이 이 프로젝트에 생성됨)
OS_SERVICE_PROJECT_ID=

# Ceph 설정 (Manila CephFS 마운트용)
CEPH_MONITORS=192.168.1.10:6789,192.168.1.11:6789,192.168.1.12:6789

# 앱 설정
BACKEND_PORT=8000
FRONTEND_PORT=3080
SECRET_KEY=change-me-in-production
# 로컬 docker compose 개발에서 예시 SECRET_KEY를 허용한다. production에서는 설정 금지.
AFTERGLOW_ALLOW_INSECURE=1
# 로컬 Compose 원격 MCP OAuth는 backend callback과 frontend return origin을 명시한다.
# Vite dev server를 쓸 때는 FRONTEND_BASE_URL을 http://localhost:5173으로 바꾼다.
AFTERGLOW_ENV=development
PUBLIC_API_BASE=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3080

# 사이트 표시 이름/설명은 afterglow.conf [app] 섹션의 site_name, site_description으로 설정
# 대시보드 새로고침 간격 (ms) — afterglow.conf의 [app].refresh_interval_ms와 동일
REFRESH_INTERVAL_MS=5000

# Inbound MCP 공개는 명시적으로만 활성화한다. URL은 각각 [mcp] public_url,
# oauth_consent_url을 환경변수로 덮어쓴다. OAuth client callback은 DCR 등록값이다.
SERVICE_MCP_ENABLED=false
MCP_PUBLIC_URL=
MCP_OAUTH_CONSENT_URL=
# 외부 로그인 콜백은 Afterglow의 GitLab OIDC 설정이다. MCP OAuth client의 callback은
# 각 client가 DCR/CIMD로 등록하며, MCP_OAUTH_CONSENT_URL과 혼동하지 않는다.
GITLAB_OIDC_REDIRECT_URI=

# Base Compose는 외부 Redis URL 필요. dev/prod 전용 manifest는 자체 private Redis 사용.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# Owned service routing only; Nova/Neutron/etc and Keystone remain on OpenStack.
# Unset: [services] *_internal_url, then catalog (dev defaults to Compose DNS).
# Uncomment to choose endpoints explicitly; an explicit empty value selects catalog.
# These values are for the BACKEND's network namespace, not the browser.
# SERVICE_WAYGATE_INTERNAL_URL=http://waygate-api:8010
# SERVICE_DROVER_INTERNAL_URL=http://drover-api:8011
# SERVICE_LUMEN_INTERNAL_URL=http://lumen-api:8012
# SERVICE_PALIMPSEST_INTERNAL_URL=http://palimpsest-api:8020
# Production explicit endpoints require HTTPS; credentials in URLs are rejected.
# Lumen -> Afterglow reverse control-plane connection; dev default is backend DNS.
# LUMEN_MCP_CONTROL_PLANE_URL=http://backend:8000
# Remote VM callbacks need a URL reachable FROM those VMs (not container DNS or
# localhost); set WAYGATE_CALLBACK_BASE_URL / DROVER_CALLBACK_BASE_URL accordingly.

# Waygate standalone service. `npm run services:up` uses literal local datastore
# URLs from docker-compose.dev.yml, overriding .env and shell values.
SERVICE_WAYGATE_ENABLED=false
WAYGATE_DATABASE_URL=mysql+aiomysql://waygate:change-me@mariadb.example.com/waygate
WAYGATE_OS_AUTH_URL=http://keystone.example.com:5000/v3
WAYGATE_OS_USERNAME=waygate
WAYGATE_OS_PASSWORD=
WAYGATE_OS_PROJECT_NAME=waygate
WAYGATE_OS_PROJECT_DOMAIN_NAME=Default
WAYGATE_OS_USER_DOMAIN_NAME=Default
WAYGATE_OS_REGION_NAME=RegionOne
WAYGATE_OS_INTERFACE=internal
WAYGATE_CALLBACK_BASE_URL=http://localhost:8010
WAYGATE_KEY_NAME=
# Existing ciphertext requires the same 64-hex value as K3S_KUBECONFIG_ENCRYPTION_KEY.
WAYGATE_ENCRYPTION_KEY=

# Drover standalone service. The isolated root workflow never uses this remote DB example.
DROVER_DATABASE_URL=mysql+aiomysql://drover:change-me@mariadb.example.com/drover
DROVER_OS_AUTH_URL=http://keystone.example.com:5000/v3
DROVER_OS_USERNAME=drover
DROVER_OS_PASSWORD=
DROVER_OS_PROJECT_NAME=drover-service
DROVER_OS_PROJECT_DOMAIN_NAME=Default
DROVER_OS_USER_DOMAIN_NAME=Default
DROVER_OS_REGION_NAME=RegionOne
DROVER_OS_INTERFACE=internal
DROVER_CALLBACK_BASE_URL=http://localhost:8011
# Existing kubeconfig/node-token ciphertext requires the original 64-hex key.
DROVER_KUBECONFIG_ENCRYPTION_KEY=

# Lumen standalone service. `npm run services:up` uses an isolated MariaDB schema
# and PostgreSQL checkpointer; it never reuses this external DATABASE_URL.
LUMEN_DATABASE_URL=mysql+aiomysql://lumen:change-me@mariadb.example.com/lumen
LUMEN_KEYSTONE_AUTH_URL=http://keystone.example.com:5000/v3
LUMEN_KEYSTONE_ADMIN_USERNAME=lumen
LUMEN_KEYSTONE_ADMIN_PASSWORD=
LUMEN_KEYSTONE_ADMIN_PROJECT=lumen-service
LUMEN_KEYSTONE_DOMAIN=Default
LUMEN_KEYSTONE_REGION_NAME=RegionOne
LUMEN_KEYSTONE_INTERFACE=internal
# Required for the local Lumen API/worker. New local data may use:
# openssl rand -hex 32
# Do not reuse a production encryption key; existing ciphertext requires its original key.
LUMEN_ENCRYPTION_KEY=

# Nova 기본값
DEFAULT_NETWORK_ID=
DEFAULT_AVAILABILITY_ZONE=nova
BOOT_VOLUME_SIZE_GB=20
UPPER_VOLUME_SIZE_GB=50

# 모니터링 (Prometheus)
# k8s 내부: http://prometheus:9090 (기본값)
# 외부 서버 지정: http://192.168.1.100:9090
PROMETHEUS_BASE_URL=http://prometheus:9090
# Kolla-Ansible 등 basic auth 설정 시 입력 (미설정 시 인증 없이 접속)
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
# Prometheus SD Bearer 토큰 (backend → Prometheus SD 인증용)
MONITORING_SD_TOKEN=
