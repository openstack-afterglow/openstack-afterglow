{
	"name": "frontend",
	"private": true,
	"version": "1.18.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.1.18",
		"@testing-library/svelte": "^5.0.0",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4",
		"jsdom": "^25.0.0",
		"svelte": "5.55.9",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^8.2.0",
		"vitest": "^4"
	},
	"dependencies": {
		"@types/qrcode": "^1.5.6",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"dompurify": "^3.4.13",
		"driver.js": "^1.6.0",
		"katex": "^0.16.22",
		"layerchart": "^2.0.0-next.64",
		"marked": "^15.0.12",
		"mermaid": "^11.16.1",
		"qrcode": "^1.5.4",
		"shiki": "^3.23.0",
		"smol-toml": "^1.7.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": "^0.28.1",
		"postcss": "^8.5.25",
		"vite": "^8.2.0"
	}
}
