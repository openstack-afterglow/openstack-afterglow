# Afterglow 통합 설정 파일
# 이 파일을 afterglow.conf로 복사해 수정하면 백엔드와 프론트엔드 전체 설정이 변경됩니다.
# 우선순위: 환경변수 > afterglow.conf > 기본값
#
# 오버라이드: 같은 디렉터리의 `afterglow.<name>.conf`을 딥 머지한다.
# 단, 브라우저 공개 projection인 `afterglow.frontend.conf`은 백엔드에서 제외한다.
# GPU 디바이스 맵은 필요할 때만 `config.gpu.toml`로 분리할 수 있다.
# 알파벳순으로 적용되어 뒤 파일이 앞을 이긴다. dict는 재귀 병합, 리스트는 덮어쓰기.
# setup.py / generate_k8s.py / config2helm.py는 파일이 없을 때 이 예시를 사용합니다.
# 첫 초기화만 app.secret_key를 생성하며 기존 키나 미선택 항목은 바꾸지 않습니다.
# 생성 도구의 --namespace는 public domain을 선택하지 않습니다. 환경별 프로필은
# --override로 명시적으로 선택합니다. 사용자 지정 파일명은 <stem>.*<suffix>를 병합합니다.

[DEFAULT]
# 애플리케이션 진단 로그만 DEBUG로 활성화합니다. 생략 시 false이며 DEBUG 환경변수가 우선합니다.
# TOML boolean은 소문자 true/false만 허용합니다. True/False는 오류이며 자동 수정하지 않습니다.
# [logging].log_level은 root/dependency 로그 제어로 유지됩니다. HTML traceback, wire dump,
# 인증 우회 또는 시크릿 출력은 활성화하지 않습니다.
debug = false

[openstack]
auth_url = "http://keystone.example.com:5000/v3"
project_name = "admin"
project_domain_name = "Default"
user_domain_name = "Default"
region_name = "RegionOne"
# interface = "internal"          # OpenStack 엔드포인트 타입: "internal" | "public" | "admin" (기본값: internal)
username = "admin"
password = "change-me-in-production"
# insecure = false                # 자체 서명 인증서 사용 시 true로 설정
# cacert = "/path/to/ca.pem"     # CA 인증서 경로 (insecure=false일 때 사용)

# Swift (Object Storage) 설정
swift_endpoint = ""               # 서비스 카탈로그 대신 직접 지정할 경우 (예: https://s3.example.com/swift/v1/AUTH_%(project_id)s)
swift_upload_timeout = 600  # Swift 업로드 타임아웃 (초)
trash_retention_days = 30   # 휴지통 보관 기간 (일). 이 기간 이후 오브젝트·버킷이 자동 영구 삭제됨.

# Manila 설정
manila_endpoint = ""              # 서비스 카탈로그 대신 직접 지정할 경우
manila_nfs_root_squash = true      # NFS access rule root_squash 강제 (보안 기본값)
manila_nfs_sec_flavor = "sys"      # NFS 인증 flavor: "sys"(기본) | "krb5"(Kerberos)
manila_cephx_key_timeout_seconds = 300  # CephX key 발급 폴링 최대 대기(초). devstack 환경에선 300 이상 권장.


# Ceph 모니터 (cloud-init CephFS 마운트용, 콤마 구분)
ceph_monitors = ""

# Native oslo.messaging notifications (RabbitMQ AMQP 0-9-1 only).
# AMQP client ships with backend dependencies; consumption is disabled unless enabled.
# Set AMQP URL ONLY in protected config or OPENSTACK_NOTIFICATIONS_AMQP_URL environment.
# Use amqps:// with a trusted CA in production; credentials must be URL-encoded.
# Services must publish oslo_messaging_notifications driver=messaging or messagingv2.
# These are EXAMPLES: use the actual control_exchange and <notification-topic>.<priority>.
# Do not use RPC method names or event_type strings as routing keys. Exchanges must exist;
# collector checks them passively, never changes their type/durability. Concrete routing
# keys work with direct/topic exchanges; wildcards require a topic exchange.
# Nova versioned notifications often use versioned_notifications.info/error instead
# of notifications.info/error. Enable both sets explicitly if the deployment emits both.
[openstack_notifications]
enabled = false
amqp_url = ""
queue_prefix = "afterglow.notifications"
retry_seconds = 5
max_message_bytes = 1048576

# Dedicated durable queue per service/exchange/routing-key; no TTL, auto-delete or purge.
# Disable a binding/service to stop consumption; its existing queue/backlog is retained.
# Changing/removing keys leaves old queues for explicit operator cleanup/drain.
# Durable queues only survive broker restart with persistent publisher messages.
[openstack_notifications.bindings.nova]
enabled = true
exchange = "nova"
routing_keys = ["versioned_notifications.info", "versioned_notifications.error"]
[openstack_notifications.bindings.cinder]
enabled = true
exchange = "cinder"
routing_keys = ["notifications.info", "notifications.error"]
[openstack_notifications.bindings.neutron]
enabled = true
exchange = "neutron"
routing_keys = ["notifications.info", "notifications.error"]
[openstack_notifications.bindings.keystone]
enabled = true
exchange = "keystone"
routing_keys = ["notifications.info", "notifications.error"]

# Ceph RBD backend 검사/복원 (관리자 볼륨 삭제 복구 전용, 선택). 두 경로가 모두 비어 있으면 비활성.
[ceph]
rbd_conf_path = ""                 # 예: /etc/ceph/ceph.conf
rbd_keyring_path = ""              # 예: /etc/ceph/ceph.client.afterglow-rbd.keyring (mode 0400)
rbd_client_name = "client.afterglow-rbd"
rbd_cluster_fsid = ""              # 활성 시 필수. `ceph fsid` 값과 불일치하면 backend 검사를 unknown 처리
rbd_command_timeout_seconds = 30
# `generate_k8s.py` 전용 입력. 실제 keyring을 Git에 커밋하지 말고 private config에서만 설정한다.
# rbd_conf_content = """[global]\nfsid = <cluster-fsid>\nmon_host = <monitor-addresses>"""
# rbd_keyring = """[client.afterglow-rbd]\nkey = <cephx-key>"""
# Cinder backend 이름(host의 `@`와 `#` 사이) → RBD pool. 활성 시 최소 1개.
[ceph.rbd_volume_pools]
ceph = "volumes"

[app]
backend_port = 8000
frontend_port = 3000
secret_key = "change-me-in-production"

# 사이트 표시 이름 및 설명 (로그인 화면 · 네비게이션 바)
site_name = "Afterglow"
site_description = "OpenStack VM + OverlayFS 배포 플랫폼"

# 로고 및 파비콘 경로 (frontend/static/ 기준, SvelteKit이 /로 서빙)
logo_path = "/afterglow-logo.svg"
logo_dark_path = "/afterglow-logo.svg"   # light theme/login background용 어두운 로고
logo_light_path = "/afterglow-logo.svg" # dark theme/login background용 밝은 로고
favicon_path = "/favicon.svg"

# 프론트엔드 대시보드 자동 새로고침 간격 (밀리초)
# 권장 범위: 3000 ~ 30000
refresh_interval_ms = 5000

# 초대 이메일 링크 생성에 사용할 프론트엔드 기본 URL (예: https://afterglow.example.com)
frontend_base_url = ""

# 브라우저에서 호출할 API Origin (예: https://afterglow.example.com).
# 비워두면 frontend_base_url, 첫 CORS origin, 개발 backend_port 순서로 유도합니다.
public_api_base = ""

# 리버스 프록시 신뢰 CIDR (쉼표 구분). 이 대역에서 온 요청의 X-Forwarded-For / X-Real-IP
# 헤더를 신뢰해 실제 클라이언트 IP 를 추출한다. 기본값은 loopback 전용.
# Docker Compose + HAProxy 프로필 사용 시 HAProxy 컨테이너의 실제 IP 대역을 명시:
#   예) "127.0.0.1/32,::1/128,172.18.0.0/16"  ← docker network inspect 로 확인
# Docker Desktop macOS 환경: 192.168.65.0/24 추가 필요
# ⚠ /12 처럼 넓은 CIDR 은 내부 컨테이너가 헤더를 위조할 수 있어 위험함
# K8s 생성기/Helm은 이 목록을 Uvicorn FORWARDED_ALLOW_IPS에도 전달해 HTTPS scheme을 보존한다.
# 직접 실행도 app.middleware.traffic_address:create_app --factory --no-proxy-headers를 사용하고
# FORWARDED_ALLOW_IPS 환경변수에 실제 proxy peer만 지정합니다. 바깥 proxy middleware는 금지합니다.
trusted_proxies = "127.0.0.1/32,::1/128"

# Optional file-owned login registry and provider allowlists. The default is
# UNRESTRICTED: every enabled registry provider and eligible SQL IAM provider is
# available, subject to native domain/IdP/protocol and SQL email/login policies.
# Registry declaration alone makes an enabled provider available in every domain
# unless an effective allowlist restricts it; it does not create Keystone federation.
# Password/email policy still comes from SQL IAM; public personal signup is configured
# separately below. File providers have public cfg:<registry-key> IDs and cannot be
# edited with SQL IAM provider CRUD.
#
# Selection contract (applies equally to registry AND SQL providers):
# - Omit auth.default.allow_providers: unrestricted, NOT an empty list.
# - Omit a domain table or its allow_providers: inherit auth.default.
# - Explicit allow_providers = []: deny all federated providers in that scope;
#   this does not itself disable password login.
# - A nonempty domain list REPLACES the default, never adds to it. List entries
#   are bare registry keys (not cfg:<key>) or canonical lowercase hyphenated SQL
#   provider UUIDs from IAM, not provider display names. SQL is not an exception.
# - Explicit list order is display order, with duplicates removed at first use.
#   Unrestricted order: registry declaration order, then SQL name/ID order.
# - Disabled providers remain unavailable even when listed. Missing/disabled or
#   foreign-domain SQL UUIDs do not become usable merely by appearing in a list.
# - Selection is enforced at resolve, authorize, callback and provider-bound
#   session refresh; hiding a button is not the only enforcement boundary.
# BREAKING migration: old [auth.default]/[auth.domain.*] selector `providers` is
# rejected. Replace it with allow_providers and recompute each complete intended
# list, including SQL UUIDs: simply renaming old additive lists changes access.
# [auth.providers.<key>] remains the registry; it is not the rejected selector.
#
# Domain keys are EXACT canonical Keystone domain IDs from `openstack domain show
# <name> -f value -c id`, NOT display names. Case is significant; no ID normalization.
# All <exact-...-domain-id> strings below are placeholders: replace with actual IDs,
# never a name such as dmslab. A provider must return the explicitly bound canonical user.
# Registry keys: 1-32 lowercase letters/digits, starting with a letter; only single
# INTERNAL underscores (gitlab_com/dmslab_gitlab). Trailing '_' and '__' are invalid
# because they collide with nested environment paths. Unknown fields/references
# and noncanonical SQL selector UUIDs fail startup (SQL existence is checked at use).
# OIDC endpoints are discovered from issuer_url, never manually overridden.
# Credentials: AUTH__PROVIDERS__<UPPERCASE_REGISTRY_KEY>__CLIENT_SECRET overrides
# client_secret from TOML without replacing sibling metadata. Empty overrides
# invalidate enabled providers. Never commit real secrets or use secret aliases.
# A top-level AUTH JSON environment value replaces the entire TOML auth object;
# use nested secret keys above for partial overrides that preserve TOML metadata.
# generate_k8s.py keeps metadata/selection in ConfigMap, credentials ONLY in Secret
# nested env keys, and injects those keys into both API and worker workloads.
# Preserve omitted allowlists as omitted, and explicit [] as []; regenerate and
# apply deployment artifacts as needed, then RESTART all API and worker processes.
# Configuration is cached at startup; changing the file alone is not a reload.
#
# Connection data is never selected by a known domain name or GitLab hostname.
# Adding another OIDC/GitHub instance is configuration-only: choose a new registry
# key, set its metadata/Secret and native IdP/protocol, then select it by domain ID.
# One issuer/application may also have multiple instances selecting different native
# protocols; identity home and selected working domain can differ after explicit linking.
# OIDC-compatible issuers use kind="oidc", not a vendor-specific kind. A new wire
# protocol needs an implemented verifier, not an arbitrary kind string.
#
# Existing domains require a delivered invitation or current native membership.
# Operator-owned [auth.providers.<key>] OIDC providers automatically connect a
# verified email to the unique enabled Accounts human; signed issuer/sub and
# boolean email_verified are mandatory. This has no dev-only/bypass flag.
# Tenant-managed SQL providers still require explicit account proof for a first
# link, even for an existing organization member. An allowlist is not email trust.
# Global stable/native tuple conflicts and duplicate Accounts owners fail closed;
# legacy non-Accounts/GitHub links still require canonical account proof.
# Organization email auto-admission remains separate and never grants ownership.
# The native mapper must use stable issuer subject (OIDC-sub) as user.id, not email or
# preferred_username, and must not overwrite the canonical user's verified email.
# New humans are created in the identity-only account domain with an owned
# project in shared personal. A generic common provider does NOT join its
# provider-origin domain. Existing-organization email autojoin stays explicit.
# Empty signup_email_domains permits all valid suffixes only when signup is enabled.
# SQL enrollment policy overrides the signup bootstrap flag and freezes future
# personal-project quota templates; neither setting grants organization access.
# Public email signup ALWAYS requires a delivered one-use email link, then unique
# normalized username/email; SMTP acceptance/client flags cannot skip verification.
# [auth]
# public_signup_enabled = false
# # Hide only the login-page signup link; email verification/direct signup and OIDC admission remain independent.
# public_signup_button_visible = true
# signup_email_domains = []
# # Organization creation is independent of signup_enabled. System admins are
# # exempt from the per-user count; existing memberships are never removed.
# organization_creation_enabled = true
# max_organizations_per_user = 10
#
# Two INDEPENDENT GitLab OIDC application registrations, not aliases. Prepare
# separate upstream applications/client credentials and native Keystone IdPs,
# protocols and mappings. The IdP IDs below must match those configured in Keystone.
# [auth.providers.gitlab_com]
# name = "GitLab.com"
# kind = "oidc"
# issuer_url = "https://gitlab.com"
# client_id = "replace-with-gitlab-com-application-id"
# # Prefer AUTH__PROVIDERS__GITLAB_COM__CLIENT_SECRET; protected TOML also works.
# client_secret = "replace-with-gitlab-com-application-secret"
# scopes = ["openid", "email", "profile"]
# keystone_idp_id = "gitlab_com"
# keystone_protocol_id = "openid"
# federation_token_type = "id_token"
# token_endpoint_auth_method = "client_secret_basic"
#
# [auth.providers.dmslab_gitlab]
# name = "DMSLab GitLab"
# kind = "oidc"
# issuer_url = "https://git.dmslab.re.kr"
# client_id = "replace-with-dmslab-gitlab-application-id"
# # Prefer AUTH__PROVIDERS__DMSLAB_GITLAB__CLIENT_SECRET; never reuse the other secret.
# client_secret = "replace-with-dmslab-gitlab-application-secret"
# scopes = ["openid", "email", "profile"]
# keystone_idp_id = "dmslab_gitlab"
# keystone_protocol_id = "openid"
# federation_token_type = "id_token"
# token_endpoint_auth_method = "client_secret_basic"
#
# Optional additional OIDC issuer and GitHub login; no application source changes.
# [auth.providers.campus_sso]
# name = "Campus SSO"
# kind = "oidc"
# issuer_url = "https://login.example.org/realms/campus"
# client_id = "replace-with-campus-application-id"
# # Supply AUTH__PROVIDERS__CAMPUS_SSO__CLIENT_SECRET separately.
# keystone_idp_id = "campus"
# keystone_protocol_id = "openid"
# # Optional operator-owned organization. This issuer/client MUST be tenant-bound:
# # EVERY identity accepted by it is trusted to join this exact organization.
# # Never use a multi-tenant/common client unless admission is upstream tenant-bound.
# # Use immutable OIDC sub values, not email/preferred_username or arbitrary claims.
# # Only these subjects may bootstrap a missing organization or receive manager.
# # Ordinary subjects can join an already established organization as reader only.
# # Issuer + id is immutable native/SQL identity; name and provider key are not.
# # Client changes require explicit binding reconciliation, never tenant adoption.
# [auth.providers.campus_sso.organization]
# id = "campus-stable-organization-id"
# name = "Campus"
# manager_subjects = ["replace-with-immutable-manager-subject"]
# # Migration100 is required before enabling this block. Uncertain creates are
# # fenced for explicit operator settlement, with no automatic replay/cleanup.
#
# [auth.providers.code_host]
# name = "GitHub"
# kind = "github"
# client_id = "replace-with-github-application-id"
# # Supply AUTH__PROVIDERS__CODE_HOST__CLIENT_SECRET separately.
# keystone_idp_id = "github"
# keystone_protocol_id = "oauth2"
#
# [auth.default]
# # No allow_providers assignment: unrestricted (all enabled instances plus eligible SQL).
# # Optional global restriction instead: uncomment the following assignment.
# # allow_providers = ["gitlab_com", "dmslab_gitlab"]
# # No auto_join_email_domains: no automatic admission unless explicitly inherited.
# # A domain-level map REPLACES this default; {} denies all automatic admission.
# # Bare registry keys or canonical SQL provider UUIDs, same selectors as allow_providers.
# # auto_join_email_domains = {}
#
# # Optional restriction for ONE exact domain: only DMSLab GitLab, no SQL additions.
# [auth.domain."<exact-restricted-domain-id>"]
# allow_providers = ["dmslab_gitlab"]
# auto_join_email_domains = { dmslab_gitlab = ["gmail.com", "konkuk.ac.kr"] }
# # No wildcard/subdomain matching: evilgmail.com and sub.konkuk.ac.kr are not permitted.
#
# # Explicitly deny all federated providers in another exact domain.
# [auth.domain."<exact-no-federation-domain-id>"]
# allow_providers = []
#
# # Inherit the default by omitting the field (or omit this whole table).
# [auth.domain."<exact-inheriting-domain-id>"]
# # No allow_providers assignment; inherits unrestricted or the configured default.
#
# # Multiple login options in another domain, in this explicit display order.
# [auth.domain."<exact-campus-domain-id>"]
# allow_providers = ["campus_sso", "code_host"]
#
# Register <app.frontend_base_url>/auth/callback in EACH upstream application;
# use the externally reachable frontend base URL. GitHub is also supported with
# kind = "github": public endpoints, read:user + user:email, access_token and
# client_secret_post defaults; HTTPS enterprise endpoints may override them.

[cache]
redis_url = "redis://redis:6379/0"

# Redis Sentinel HA (false = 단일 Redis, true = Sentinel 고가용성 모드)
# K8s 배포 시 generate_k8s.py 가 sentinel_enabled = true 로 자동 설정한다.
sentinel_enabled = false
sentinel_master_name = "mymaster"
sentinel_hosts = ""  # 콤마 구분 "host:port" (예: "sentinel-a:26379,sentinel-b:26379")

# TTL 티어 (초). 리소스 변경 빈도에 따라 분류.
ttl_fast = 15       # 인스턴스, 볼륨, 플로팅IP 등 빈번히 변하는 리소스
ttl_normal = 30     # 네트워크, 라우터, 토폴로지, 대시보드
ttl_slow = 60       # 키페어, 보안그룹, 관리자 프로젝트/그룹/역할
ttl_static = 300    # 이미지, 플레이버, 토큰 검증
default_ttl_seconds = 30  # TTL 티어 미지정 리소스의 기본 캐시 TTL (초)

# 캐시 백엔드: "redis" 또는 "valkey" (v1 은 동일 redis-py 클라이언트 사용)
backend = "redis"
# Dynamic TTL 조정 임계치 (시간당 mutation 횟수)
dynamic_threshold_low = 5
dynamic_threshold_high = 20

# 3-tier TTL 카테고리 (초) — 데이터 특성 기반 분류
ttl_identity_stable = 86400  # 개인 프로필, role/group 멤버십 (1일)
ttl_catalog_slow = 900       # flavors, image 메타, 데이터스토어, 클러스터 템플릿 (15분)
ttl_project_meta = 300       # keypair, SG 정의, 네트워크 메타 (5분)
ttl_operational_live = 30    # instances/volumes/FIP/컨테이너 상태 (30초)
ttl_admin_overview = 60      # admin 토폴로지, 하이퍼바이저 (60초)
ttl_auth_token = 60          # Keystone 토큰 검증 결과 (60초)

[session]
# 세션 유지 시간 (초). 이 시간이 지나면 재로그인 필요.
# Keystone 토큰 만료 시간보다 짧게 설정 권장 (Keystone 기본값: 3600초)
timeout_seconds = 3600
# JWT access/refresh 토큰 수명 (초)
jwt_access_ttl = 900      # access 토큰 (기본 15분)
jwt_refresh_ttl = 604800  # refresh 토큰 (기본 7일)
# 토큰 출처 IP/기기 바인딩 검사 모드
#   off    — 검사 없음
#   log    — 불일치 로깅만, 차단 없음
#   subnet — IP가 다른 /24(IPv4)·/64(IPv6) 대역이면 차단 (기본값)
#   strict — IP 정확 불일치 또는 기기 지문 불일치 시 차단
token_ip_binding_mode = "subnet"

[security]
# 관리자 접근은 Keystone system:all의 admin 역할만 허용합니다.
# 최초 관리자/잠금 복구: backend/scripts/bootstrap_system_admin.py (운영자 명시 실행)
# 로그인 브루트포스 방어
login_max_attempts = 10       # 연속 실패 후 계정 잠금 임계값
login_lockout_seconds = 300   # 기본 잠금 시간 (초)
login_backoff_base = 2        # 지수 백오프 밑수 (실패 반복 시 잠금 시간 증가)

[nova]
boot_volume_size_gb = 20
upper_volume_size_gb = 50

# 프로젝트별 기본 네트워크 자동 생성/관리
default_network_enabled = true                # true 시 사용자 로그인 시 기본 네트워크 자동 생성
default_network_cidr = "192.168.0.0/24"       # 자동 생성 네트워크의 서브넷 CIDR

# 추가 GPU 디바이스 맵은 선택적으로 `config.gpu.toml`에 둘 수 있습니다.
# 같은 디렉터리에 두면 afterglow.conf에 딥 머지되어 적용됩니다.


[services]
# 선택적 OpenStack 서비스 활성화 여부 (false면 라우터 미등록 + 사이드바 숨김)
magnum = false      # K8s 클러스터 (Heat 포함)
manila = false      # 공유 파일 시스템
zun = false         # 컨테이너
cloud_shell = false # 전역 Cloud Shell (Zun + 전용 서비스 프로젝트 필요)
k3s = false         # k3s 자체 관리 Kubernetes 클러스터
swift = false       # 오브젝트 스토리지
trove = false       # DBaaS (Database as a Service)
barbican = false    # Key Manager (시크릿/인증서 관리)
waygate = false     # Waygate (활성화 시 [waygate] 섹션 설정 필수)
palimpsest = false   # Palimpsest Hub (legacy JWT: URL 또는 카탈로그; 패키지: 신뢰된 palimpsest_internal_url 필수)
chat = false        # 빌트인 AI 채팅 (활성화 시 [chat] 섹션 + 관리자 페이지에서 프로바이더/모델 등록)
mcp = false         # Consumer MCP control plane (Stage 2 publish gate 전까지 false 유지)
# Generic owned-service routes: explicit endpoint, otherwise authenticated Keystone catalog.
# Environment SERVICE_<SERVICE>_INTERNAL_URL wins; empty = catalog only for generic routes.
# Host backend examples: http://127.0.0.1:8010 (Waygate), :8011 (Drover),
# :8012 (Lumen), :8020 (Palimpsest). Inside Compose use service DNS, not localhost.
# Dev runner uses nonempty values in .local-services/afterglow.conf, otherwise
# defaults to its local service DNS. Base/prod have no local default; prod requires HTTPS.
# Native package keys and browser package BFF require a trusted nonempty
# SERVICE_PALIMPSEST_INTERNAL_URL or [services] palimpsest_internal_url; absent/empty
# means 503, never catalog/admin discovery or token exchange. Legacy JWT Hub routes
# retain catalog behavior. Package redirects are forbidden; downloads stream, private no-store.
# Readable namespaces require Hub operator bindings to exact Keystone project UUID/IDs;
# IDs are opaque (no case/hyphen normalization or project-name inference).
# package_authority comes from Hub's PALIMPSEST_HUB_PACKAGE_PUBLIC_ORIGIN (trusted HTTPS),
# not this internal service URL or the browser origin.
waygate_internal_url = ""
drover_internal_url = ""
lumen_internal_url = ""
palimpsest_internal_url = ""

[cloud_shell]
# 모든 컨테이너와 영구 홈 볼륨은 사용자 프로젝트가 아니라 이 전용 프로젝트에 생성됩니다
# (os_service_project_id와 다른 프로젝트여야 합니다). 운영자는 전용 프로젝트와 쿼터를 준비합니다.
# network_id를 비우면 전용 프로젝트의 기본 네트워크를 사용합니다. 외부 연결이 필요하며,
# 직접 지정하는 네트워크도 전용 프로젝트 소유여야 합니다.
# security_group을 비우거나 "default"로 두면 전용 프로젝트의 default 그룹과 기존 규칙을 사용합니다.
# egress-only를 보장하지 않으며, 직접 지정하는 보안 그룹도 전용 프로젝트 소유여야 합니다.
service_project_id = ""
# Image source: https://github.com/openstack-afterglow/openstack-client (slim / alpine).
# 개발은 :slim 태그를 사용할 수 있지만 운영은 게시된 manifest @sha256:<digest>로 고정합니다.
image = "ghcr.io/openstack-afterglow/openstack-client:slim"
# 빈 값은 Zun 기본 정책. always / ifnotpresent / never 명시는 Zun의 admin 정책 권한이 필요합니다.
image_pull_policy = ""
# 비공개 GHCR/GitLab은 전용 프로젝트에 등록한 Zun registry UUID를 지정합니다. 비밀번호/토큰은 Zun에서 관리합니다.
registry_id = ""
network_id = ""
security_group = "default"
# Cloud Shell 내부 OpenStack CLI가 사용할 Keystone v3 URL. 운영은 HTTPS만 허용합니다.
auth_url = "https://keystone.example.com/v3"
interface = "public"
volume_type = ""
home_size_gib = 5
cpu = 1.0
memory_mib = 1024
idle_timeout_seconds = 1200
max_session_seconds = 3600
ticket_ttl_seconds = 60
reconcile_interval_seconds = 60
# Zun exec proxy의 정확한 origin. 운영은 WSS만 허용합니다(경로/쿼리 금지).
zun_websocket_origin = "wss://zun-ws.example.com"

[mcp]
# Inbound consumer MCP control plane. Keep services.mcp=false until the Stage 2 publish gate passes.
# 외부 MCP 클라이언트가 접속하는 정확한 HTTPS Streamable HTTP resource URL.
# 비우면 public_api_base + /api/v1/mcp. 명시 URL은 root·custom path를 그대로 사용한다.
# 도메인만 지정하면 전용 호스트의 루트(/)에서 제공하며 웹/API와 다른 호스트가 필요하다.
# DMSLAB shared-host 예: https://cloud.dmslab.re.kr/mcp
public_url = ""
# 로그인(로컬 또는 OIDC) 후 표시할 Afterglow OAuth 승인 페이지 URL. 비우면
# frontend_base_url + /oauth/mcp/authorize 를 사용한다. 클라이언트의 redirect_uri는
# DCR/CIMD 등록 값으로만 받고 여기서 지정하지 않는다.
oauth_consent_url = ""
# Lumen이 opaque grant snapshot을 재검증하는 내부 MCP bridge workload credential.
# 개인 MCP token이나 Keystone token이 아니며 secret.yaml으로만 전달한다.
lumen_service_token = ""
authorization_ticket_ttl_seconds = 600
access_token_ttl_seconds = 900
default_grant_ttl_days = 30
max_grant_ttl_days = 90
max_personal_tokens = 10
max_delegated_grants = 20
request_max_bytes = 1048576
read_result_max_bytes = 524288
mutation_result_max_bytes = 65536
default_page_size = 50
max_page_size = 100
concurrent_calls_per_grant = 4
read_rate_per_minute = 120
mutation_rate_per_minute = 20

[instance_health]
# VM cloud-init health reports target this Afterglow endpoint. This is unrelated
# to Drover's K3s guest callback and remains owned by the instance service.
callback_base_url = ""         # e.g. http://10.0.0.1:8000

[k3s]
# Shared legacy AES-256-GCM key for existing encrypted Afterglow records.
# Drover uses its own [drover] kubeconfig_encryption_key.
kubeconfig_encryption_key = "" # 32-byte hex; generate: openssl rand -hex 32
# Shared token for internal K3s GPU admission endpoint (/api/v1/internal/k3s/gpu-admission).
gpu_admission_token = ""
[worker_runtime]
# Background worker runtime manager.
# Default static mode preserves the current fixed Compose/Kubernetes/Kolla worker manifests
# (the [worker_runtime] block is inert; workers run from those manifests).
# docker/kubernetes modes are explicit opt-in and never auto-detected.
#
# Activation:
#   docker mode     -> use docker-compose.worker-runtime.yml overlay (fills the [worker_runtime.docker] block below)
#   kubernetes mode -> set mode via Helm values-<env>.yaml (workerRuntime.mode + kubernetes.rbac.create=true)
# At the default max_replicas = 1 the manager can only toggle 0<->1 (pause/resume) via
#   PATCH /api/v1/admin/worker-runtime/desired; true multi-replica scaling needs a higher
#   max_replicas AND verified worker concurrency-safety.
mode = "static"                  # static | docker | kubernetes
reconcile_interval = 30           # seconds; 0 disables the backend reconcile loop
fail_closed = true                # reserved: parsed but not yet consumed by adapters

[worker_runtime.workers.notion_worker]
enabled = true
desired_replicas = 1
max_replicas = 1
module = "app.notion_worker"

[worker_runtime.docker]
# Docker mode requires the backend container to have an explicit Docker socket mount
# plus host-visible bind source paths. These are intentionally empty by default so
# opt-in Docker mode reports unavailable instead of creating broken containers.
socket_path = ""                  # e.g. /var/run/docker.sock
image = ""                        # required when mode = "docker"
network = ""                      # optional Docker network name
config_mount = "/app/afterglow.conf"
config_host_path = ""             # host path for afterglow.conf, not backend-container path
gpu_config_mount = "/app/config.gpu.toml"
gpu_config_host_path = ""         # optional host path for config.gpu.toml
logs_mount = "/app/logs"
logs_host_path = ""               # optional host path for worker logs
env_allowlist = "AFTERGLOW_ENV,AFTERGLOW_ALLOW_INSECURE,SECRET_KEY,OS_PASSWORD,DATABASE_URL,K3S_KUBECONFIG_ENCRYPTION_KEY,K3S_GPU_ADMISSION_TOKEN,PROMETHEUS_PASSWORD,NOTION_CONFIG_ENCRYPTION_KEY"

[worker_runtime.kubernetes]
namespace = "afterglow"
service_account_token_path = "/var/run/secrets/kubernetes.io/serviceaccount/token"
service_account_ca_path = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
manage_deployments = false        # v1: must remain false; managed Deployment creation is not exposed



[builder]
# 영구 Builder VM (SSH 기반 빌드 파이프라인)
# persistent_server_id: 기존 VM이 있으면 Nova UUID 입력 (없으면 최초 빌드 시 자동 생성)
persistent_server_id = ""
# ssh_user: Builder VM SSH 사용자 (Ubuntu 이미지 기본값 "ubuntu")
ssh_user = "ubuntu"
# ssh_key_path: SSH 개인키 파일 경로
#   - K8s: Secret 볼륨으로 /etc/afterglow/ssh/builder.key 에 마운트
#   - 로컬/Compose: 최초 생성 시 이 경로에 자동 저장
ssh_key_path = "/etc/afterglow/ssh/builder.key"
# ssh_private_key: SSH 개인키 내용 (PEM 형식)
#   - K8s 배포 전용: generate_k8s.py가 이 값을 secret.yaml의 BUILDER_SSH_PRIVATE_KEY 로 출력
#     → deployment.yaml이 afterglow-secrets의 BUILDER_SSH_PRIVATE_KEY 를 ssh_key_path 경로에 마운트
#   - 로컬 환경에서는 이 필드를 비워 두거나 생략 (파일을 직접 관리)
#   - 생성: ssh-keygen -t ed25519 -C "afterglow-builder" -f builder.key
ssh_private_key = ""
# ssh_host: Builder VM의 Floating IP (비워두면 Nova에서 자동 조회)
ssh_host = ""
# build_timeout: 빌드 SSH 명령 최대 대기 시간 (초, 기본값 3600)
build_timeout = 3600
# layer_share_size_gb: 레이어 빌드 시 동적 생성되는 Manila NFS share 용량 (GB, 기본값 20)
# torch 등 대용량 패키지를 포함하는 레이어는 더 크게 설정 권장
layer_share_size_gb = 20




[palimpsest]
# Palimpsest 로컬 KVM 런타임 (선택) — docs/palimpsest.md 참조

# --- 로컬 KVM 런타임 (선택) ---
# OpenStack 없이 로컬/원격 KVM 호스트에 레이어드 VM 을 띄운다. 레이어는 virtio-blk
# 읽기 전용 디스크로 붙고 게스트는 OpenStack 경로와 동일하게 OverlayFS 로 합성한다.
#
# ⚠️ libvirt-python 은 별도 extra 다 — `uv sync --extra kvm` (시스템 libvirt-dev 필요).
#    설치하지 않으면 이 기능만 503 이고 나머지는 영향이 없다.
#
# kvm_uri: 비워 두면 기능 비활성. 예) "qemu:///system" 또는 "qemu+ssh://ops@kvm-host/system"
kvm_uri = ""
# kvm_layer_root: 레이어 blob 이 놓인 호스트 경로.
#   허브 OCI 번들을 그대로 펼치면 이 배치가 된다 — <kvm_layer_root>/blobs/sha256/<hex>
kvm_layer_root = "/var/lib/palimpsest/layers"
# kvm_state_dir: 도메인별 루트 오버레이(qcow2)와 NoCloud seed ISO 를 두는 경로
kvm_state_dir = "/var/lib/palimpsest/domains"



[notion]
# Notion 연동 설정 (선택적)
# config_encryption_key = ""  # Notion 설정 암호화 키 (미설정 시 k3s.kubeconfig_encryption_key 재사용)


[logging]
# 파일 로그 설정
# log_directory = "logs"        # 로그 디렉터리 경로 (기본값: "logs")
# log_level = "INFO"            # 로그 레벨: DEBUG, INFO, WARNING, ERROR, CRITICAL
# max_bytes = 52428800          # 단일 로그 파일 최대 크기 (바이트, 기본값: 50MB)


[gpu]
# GPU 가용량을 사용자에게 노출할지 여부
# true 시 VM 생성 위자드의 GPU Flavor 선택에서 타입별 잔여 수량이 표시됨
available_visible = false


[database]
# k3s 클러스터 영속화용 MariaDB/MySQL 연결 URL (선택적)
# 미설정 시 기존 Redis 방식으로 동작
# url = "mysql+aiomysql://afterglow:password@mariadb.example.com:3306/afterglow"
url = ""
# 커넥션 풀 설정
pool_size = 5
max_overflow = 10
# 앱 시작 시 테이블 자동 생성 (개발/테스트용, 운영에서는 false 후 migrations/ SQL 수동 실행 권장)
auto_create_tables = true
# MySQL TCP/핸드셰이크 대기 시간(초). 일시적 네트워크 지연을 견디려면 늘릴 것
connect_timeout = 10
# 커넥션 풀에서 빈 커넥션을 기다리는 시간(초)
pool_timeout = 10
# OperationalError 발생 시 모든 DB 호출을 즉시 차단할 시간(초). 짧으면 회복이 빠르고, 길면 죽은 DB에 재시도 비용을 줄임
unhealthy_seconds = 15
# 자동 DB 백업 실행 시각 (cron 표현식, notion-worker가 APScheduler로 실행)
# db_auto_backup_cron = "0 3 * * *"   # 매일 새벽 3시

[monitoring]
# 관리자 호스트 관측: Prometheus 없이 backend에서 직접 /metrics를 10초마다 조회.
# Redis 공유 snapshot/HA lease와 Nova 읽기 권한의 설정된 OpenStack 계정이 필요합니다.
# node_exporter 설치/방화벽/인증 없는 관리망 HTTP 접근은 운영자가 준비합니다 (자동 변경 없음).
# Nova compute host_ip, scheduler/conductor host DNS를 자동 발견합니다.
# role = "compute" | "controller" | "storage". 같은 role/name은 주소/포트를 override합니다.
# Nova에 없는 컨트롤러와 모든 storage 노드는 명시적으로 추가합니다 (storage heartbeat는 미관측).
# address는 bare DNS 이름 또는 IP만 허용하며 URL/인증/path/query 및
# loopback/link-local/metadata/special IP와 그런 주소로 해석되는 DNS 이름은 거부합니다.
# 예: [{ name = "controller-1", address = "10.20.0.11", role = "controller", port = 9100 },
#      { name = "ceph-1", address = "10.20.0.31", role = "storage" }]
host_healthcheck_enabled = true
host_healthcheck_targets = []
# 3초 probe, 동시 8개/최대 64호스트, 2MiB body, 30초 staleness, 10분/최대 60 points.
# disk는 writable root filesystem만, network는 loopback/일반 virtual NIC 제외 aggregate.
# 물리 NIC별 byte/packet counter·rate(최대 32개)와 exporter의 MAC/operstate label만 제공합니다.
# NIC 주소는 node_exporter --collector.netdev.address-info 사용 시에만 표시되며, 없으면 미수집(null)입니다.
# 직접 exporter reachability와 Nova heartbeat는 별개이며 host-to-host 통신 증거가 아닙니다.
# 호스트 토폴로지: scripts/host_observer.py를 각 Linux 호스트에서 실행해야 합니다.
# host_id별 서로 다른 무작위 URL-safe token(32자 이상). 실제 값은 protected config/Secret에만 보관.
infrastructure_topology_enabled = false
infrastructure_topology_observers = []
# 예: [{ host_id = "compute:compute-1", token = "<operator-generated-secret>" }]
# 관리자가 명시적으로 시작하는 경로 진단의 literal unicast IP만 허용. DNS/CIDR/광역 스캔 없음.
infrastructure_topology_trace_targets = []
# 10초 주기 directed TCP 연결 확인. 지정 호스트/주소/서비스 포트만 확인하며 데이터 plane/역방향 보장 아님.
# 예: [{ source_host_id = "compute:compute-1", target_host_id = "controller:controller-1", address = "10.20.0.11", port = 9100 }]
infrastructure_topology_peer_targets = []
infrastructure_topology_retention_seconds = 3600
# Prometheus 서버 주소 (K8s 환경에서는 in-cluster DNS 권장)
prometheus_base_url = "http://prometheus:9090"
prometheus_username = ""        # basic auth 사용자명 (미사용 시 빈 문자열)
prometheus_password = ""        # basic auth 비밀번호 (secret.yaml에서 주입)
# Prometheus Service Discovery 인증 토큰 (/api/v1/sd/prometheus/targets)
sd_token = ""                   # secret.yaml에서 주입
# Prometheus scrape 대역 CIDR (예: 10.0.0.0/8). monitoring API 사용 시 필수.
scrape_cidr = ""
# 프로젝트/인스턴스 생성 시 모니터링 Security Group 자동 부착
auto_sg_enabled = true
node_exporter_sg_name = "node_exporter"   # node_exporter ingress SG 이름 (tcp/9100)
dcgm_exporter_sg_name = "dcgm_exporter"  # dcgm_exporter ingress SG 이름 (tcp/9400, GPU 전용)
# VM 메트릭 수집 포트 (기본값 유지 권장)
node_exporter_port = 9100       # VM에 설치된 node_exporter 포트 (기본 9100)
dcgm_exporter_port = 9400       # GPU VM의 dcgm_exporter 포트 (기본 9400)
libvirt_exporter_port = 9177    # compute 노드 libvirt_exporter 포트 (기본 9177, kolla enable_prometheus_libvirt_exporter)
gpu_flavor_prefix = "gpu."      # GPU 노드 판별 flavor prefix (예: "gpu." → gpu.a100x1_80gb 등)
# Grafana 연동
grafana_base_url = ""           # Grafana 외부 URL (예: https://grafana.example.com)
                                # 이 값은 frontend 의 PUBLIC_GRAFANA_BASE 로도 주입되어 CSP frame-src 에 포함됩니다

# === Prometheus scrape 설정 참고 (K8s ConfigMap에서 자동 생성 — 직접 수정 불필요) ===
# scrape_configs:
#   - job_name: "instances-node"
#     http_sd_configs:
#       - url: "http://backend:8000/api/v1/sd/prometheus/targets"
#         refresh_interval: 30s
#         authorization:
#           credentials_file: /etc/prometheus/sd-token
#   - job_name: "instances-dcgm"
#     http_sd_configs:
#       - url: "http://backend:8000/api/v1/sd/prometheus/targets"
#         refresh_interval: 30s

[monitoring.dashboards]
# Grafana 대시보드 UID. 지정한 Grafana에 해당 UID의 대시보드가 있어야 함.
node_uid = "afterglow-node"
rabbitmq_uid = "afterglow-rabbitmq"
mysqld_uid = "afterglow-mysqld"
proxysql_uid = "afterglow-proxysql"  # 기존 ProxySQL — MariaDB 접속 경로 대시보드
memcached_uid = "afterglow-memcached"
etcd_uid = "afterglow-etcd"
haproxy_uid = "afterglow-haproxy"
libvirt_uid = "afterglow-libvirt"
openstack_uid = "afterglow-openstack"
ceph_uid = "afterglow-ceph"
instance_cpu_uid = "afterglow-instance-cpu"   # CPU 전용 인스턴스 per-VM 대시보드
instance_gpu_uid = "afterglow-instance-gpu"   # GPU 인스턴스 per-VM 대시보드

# 물리 스위치 IF-MIB/LLDP-MIB의 read-only SNMPv3 authPriv 관측.
# 매 대상/자격/disable 변경 때 revision을 증가시킵니다. 실제 target이 있으면 positive revision 필수.
# management IP는 운영자가 승인한 exact literal IP이며 LLDP 광고로 자동 등록하지 않습니다.
[monitoring.infrastructure_fabric]
revision = 0
targets = []
poll_interval_seconds = 10
freshness_seconds = 30
timeout_seconds = 2
retries = 1
concurrency = 4
poll_budget_seconds = 30
max_ports = 256
max_neighbors = 256
max_varbinds = 16384
retention_seconds = 3600
# target의 username/auth_key/priv_key는 보호된 operator TOML 또는
# MONITORING_INFRASTRUCTURE_FABRIC__TARGETS Secret JSON에만 둡니다. ConfigMap/공개 frontend에는 금지.

[traffic_analytics]
# 관리자 국가별/경로별 트래픽, IP 기반 고유 방문 추정. 쿠키/요청 body/토큰/원문 IP를 저장하지 않습니다.
enabled = false
retention_days = 30
# 읽기 전용 IPv4/IPv6 전체 대역 MMDB. DB-IP Country Lite는 월별 배포와 화면 출처 표기가 필요합니다.
# Runtime 외부 조회·다운로드는 없으며 데이터 교체 후 backend worker를 재시작합니다.
geoip_mmdb = ""
# 실제 클러스터 대역만 등록합니다. 모든 RFC1918 주소를 내부 요청으로 간주하지 않습니다.
cluster_cidrs = []
# Analytics 원본 주소 판정의 exact proxy CIDR. Uvicorn auth/scheme의 FORWARDED_ALLOW_IPS와 별도입니다.
# /0 및 전체 인터넷 trust는 금지합니다. 직접 peer·최종 forwarded chain을 먼저 검증합니다.
backend_trusted_proxy_cidrs = []
frontend_trusted_proxy_cidrs = []
# 서비스 인입 국가(대문자 ISO-3166 2자리, 예: KR). 논리적 접속 흐름을 그릴 때만 사용하며 실제 네트워크 경로가 아닙니다.
# 빈 값은 미설정입니다. 위치 미확인 버킷 XX는 사용할 수 없습니다.
site_country = ""
# 서로 다른 32자 이상 비밀. 배포에서는 TRAFFIC_ANALYTICS__HMAC_KEY / __FRONTEND_INGEST_KEY Secret 사용.
hmac_key = ""
frontend_ingest_key = ""
# Frontend ADDRESS_HEADER는 unset으로 두고 TRAFFIC_ANALYTICS_PEER_IS_SOCKET=true를 사용합니다.
# getClientAddress의 실제 TCP peer와 bounded XFF를 보호된 ingest로 보내 backend가 신뢰 경계를 판정합니다.
# 서버 전용 환경: TRAFFIC_ANALYTICS_INGEST_URL=<backend>/api/v1/monitoring/traffic/events
# TRAFFIC_ANALYTICS_INGEST_KEY는 위 frontend_ingest_key와 일치해야 합니다. PUBLIC_*에 넣지 마십시오.
# 프론트엔드 문서 요청과 backend API를 별도 집계하며 CDN에서 종료된 요청/SPA 이동은 관측하지 않습니다.



[smtp]
# 이메일 전송 설정 (프로젝트 초대 기능에 사용)
enabled = false
host = ""                   # SMTP 서버 호스트 (예: smtp.gmail.com)
port = 587                  # SMTP 포트 (587 = STARTTLS, 465 = SSL)
username = ""               # SMTP 인증 사용자명
password = ""               # SMTP 인증 비밀번호 (secret.yaml에서 주입)
from_address = "noreply@afterglow.example.com"
from_name = "Afterglow"
use_tls = true              # STARTTLS 사용 여부

[smtp.invitation]
token_expiry_days = 7       # 초대 링크 유효 기간 (일)


[cors]
# CORS 허용 origin (쉼표 구분). 프론트엔드 실제 접근 URL로 설정.
# 이 값이 S3 직접 업로드(multipart) 시 RGW quarantine 버킷 CORS 의 AllowedOrigins 로도 사용됨.
# 프로덕션 도메인을 첫 번째로, 개발 도메인을 이후에 나열.
# 예: origins = "https://cloud.dmslab.re.kr,http://localhost:3080,http://127.0.0.1:3080"
origins = "https://afterglow.example.com,http://localhost:3080,http://127.0.0.1:3080"

# 파일 공급자: 위 [auth] 예제. SQL 공급자·이메일 제한·회원가입 정책은 도메인 IAM에서 관리합니다.
# SQL 공급자 secret 암호화와 파일 공급자 revision/pin에 쓰이는 k3s.kubeconfig_encryption_key를 보존·복구해야 합니다.
