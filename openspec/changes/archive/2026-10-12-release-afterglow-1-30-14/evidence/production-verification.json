    "grant_create": "mcp_delegated_grants\tCREATE TABLE `mcp_delegated_grants` (\\n  `id` char(36) NOT NULL,\\n  `owner_user_id` varchar(64) NOT NULL,\\n  `owner_project_id` varchar(64) NOT NULL,\\n  `upstream_credential_name` varchar(128) NOT NULL,\\n  `display_name` varchar(100) NOT NULL,\\n  `source` varchar(20) NOT NULL,\\n  `access_level` varchar(10) NOT NULL,\\n  `project_scope` varchar(20) NOT NULL DEFAULT 'current',\\n  `approved_projects` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`approved_projects`)),\\n  `status` varchar(10) NOT NULL,\\n  `application_credential_id` varchar(128) DEFAULT NULL,\\n  `credential_ciphertext` mediumtext DEFAULT NULL,\\n  `credential_epoch` bigint(20) NOT NULL,\\n  `expires_at` datetime(6) DEFAULT NULL,\\n  `issued_at` datetime DEFAULT NULL,\\n  `revoked_at` datetime DEFAULT NULL,\\n  `cleanup_pending` tinyint(1) NOT NULL,\\n  `cleanup_last_attempt_at` datetime DEFAULT NULL,\\n  `orphan_recovery_after` datetime DEFAULT NULL,\\n  `orphan_recovery_nonce` char(36) DEFAULT NULL,\\n  `last_used_at` datetime DEFAULT NULL,\\n  `created_at` datetime NOT NULL,\\n  `updated_at` datetime NOT NULL,\\n  `consented_at` datetime(6) DEFAULT NULL,\\n  `client_observations` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`client_observations`)),\\n  PRIMARY KEY (`id`),\\n  UNIQUE KEY `upstream_credential_name` (`upstream_credential_name`),\\n  KEY `idx_mcp_grants_owner_status` (`owner_user_id`,`owner_project_id`,`status`),\\n  KEY `idx_mcp_grants_expiry` (`expires_at`,`status`),\\n  CONSTRAINT `chk_mcp_grant_access` CHECK (`access_level` in ('read','manage')),\\n  CONSTRAINT `chk_mcp_grant_status` CHECK (`status` in ('pending','active','revoked','expired')),\\n  CONSTRAINT `chk_mcp_grant_source` CHECK (`source` in ('personal_token','oauth','lumen')),\\n  CONSTRAINT `chk_mcp_grant_project_scope` CHECK (`project_scope` in ('current','selected','all')),\\n  CONSTRAINT `chk_mcp_grant_expiry` CHECK (`expires_at` is not null or `source` = 'personal_token')\\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci\n",
    "child_create": "mcp_project_credentials\tCREATE TABLE `mcp_project_credentials` (\\n  `grant_id` char(36) NOT NULL,\\n  `project_id` varchar(64) NOT NULL,\\n  `upstream_credential_name` varchar(128) NOT NULL,\\n  `application_credential_id` varchar(128) DEFAULT NULL,\\n  `credential_ciphertext` mediumtext DEFAULT NULL,\\n  `cleanup_pending` tinyint(1) NOT NULL DEFAULT 1,\\n  PRIMARY KEY (`grant_id`,`project_id`),\\n  UNIQUE KEY `upstream_credential_name` (`upstream_credential_name`),\\n  CONSTRAINT `mcp_project_credentials_ibfk_1` FOREIGN KEY (`grant_id`) REFERENCES `mcp_delegated_grants` (`id`) ON DELETE CASCADE\\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_general_ci\n",
